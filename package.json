{
  "name": "responders-academy-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "mocks:sync": "node scripts/sync-mocks.mjs",
    "mocks:validate": "python3 spec/mocks/_tools/validate_mocks.py",
    "predev": "npm run mocks:sync",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "prebuild": "npm run mocks:sync && npm run mocks:validate",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "steiger": "steiger ./src",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run mocks:sync",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run format:check && npm run steiger && npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "steiger": "^0.6.0",
    "typescript": "latest",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
