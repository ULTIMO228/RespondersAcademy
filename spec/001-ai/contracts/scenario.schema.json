{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScenarioVersion",
  "description": "Полный конверт новой версии сценария. Старый /api/mock/scenarios сохраняет собственный контракт.",
  "allOf": [
    {
      "$ref": "#/$defs/scenarioExtension"
    },
    {
      "type": "object",
      "required": [
        "sourceSituationNo",
        "sourceKind",
        "sourceHash",
        "validation",
        "cardSnapshot",
        "ruleSourceIds"
      ],
      "properties": {
        "sourceHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "validation": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "cardSnapshot": {
          "type": "object",
          "required": [
            "id",
            "fields"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "fields": {
              "type": "object"
            }
          },
          "additionalProperties": true
        },
        "ruleSourceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sourceAttemptId": {
          "type": "string",
          "minLength": 1
        },
        "sourceCardId": {
          "type": "string",
          "minLength": 1
        },
        "sourceCardVersion": {
          "type": "integer",
          "minimum": 1
        },
        "approvedBy": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sourceKind": {
                "const": "student_card"
              }
            },
            "required": [
              "sourceKind"
            ]
          },
          "then": {
            "required": [
              "sourceAttemptId",
              "sourceCardId",
              "sourceCardVersion"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "approval": {
                "const": "approved"
              }
            },
            "required": [
              "approval"
            ]
          },
          "then": {
            "properties": {
              "validation": {
                "const": "passed"
              }
            },
            "required": [
              "approvedBy"
            ]
          }
        }
      ]
    }
  ],
  "$defs": {
    "mode": {
      "type": "string",
      "enum": [
        "operator112",
        "dds"
      ]
    },
    "scenarioExtension": {
      "type": "object",
      "required": [
        "schemaVersion",
        "scenarioId",
        "version",
        "mode",
        "sourceTicketId",
        "etalonVersion",
        "approval"
      ],
      "properties": {
        "schemaVersion": {
          "const": "ai-workflow/1"
        },
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "sourceTicketId": {
          "type": "string",
          "minLength": 1
        },
        "sourceSituationNo": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "sourceKind": {
          "type": "string",
          "enum": [
            "ticket",
            "template",
            "llm",
            "student_card"
          ]
        },
        "etalonVersion": {
          "type": "string",
          "minLength": 1
        },
        "approval": {
          "type": "string",
          "enum": [
            "draft",
            "validation_failed",
            "pending_review",
            "approved",
            "rejected"
          ]
        },
        "parentVersion": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    }
  }
}
