{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "responders-academy/ai-workflow/1",
  "title": "Дополнения к четырём контрактам учебного контура",
  "description": "Валидирует новые поля поверх существующих Scenario, CardEvent, Evaluation и SessionReport. Не заменяет базовые схемы specs/002-two-mode-simulator/contracts/.",
  "$defs": {
    "mode": { "type": "string", "enum": ["operator112", "dds"] },
    "scenarioExtension": {
      "type": "object",
      "required": ["schemaVersion", "scenarioId", "version", "mode", "sourceTicketId", "etalonVersion", "approval"],
      "properties": {
        "schemaVersion": { "const": "ai-workflow/1" },
        "scenarioId": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "mode": { "$ref": "#/$defs/mode" },
        "sourceTicketId": { "type": "string", "minLength": 1 },
        "sourceSituationNo": { "type": "integer", "minimum": 1, "maximum": 3 },
        "sourceKind": { "type": "string", "enum": ["ticket", "template", "llm", "student_card"] },
        "etalonVersion": { "type": "string", "minLength": 1 },
        "approval": { "type": "string", "enum": ["draft", "validation_failed", "pending_review", "approved", "rejected"] },
        "parentVersion": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": true
    },
    "eventExtension": {
      "type": "object",
      "required": ["schemaVersion", "id", "attemptId", "seq", "mode", "kind", "occurredAt"],
      "properties": {
        "schemaVersion": { "const": "ai-workflow/1" },
        "id": { "type": "string", "minLength": 1 },
        "attemptId": { "type": "string", "minLength": 1 },
        "seq": { "type": "integer", "minimum": 0 },
        "mode": { "$ref": "#/$defs/mode" },
        "kind": { "type": "string", "minLength": 1 },
        "occurredAt": { "type": "string", "format": "date-time" },
        "payload": { "type": "object" }
      },
      "additionalProperties": true
    },
    "errorRecord": {
      "type": "object",
      "required": ["id", "attemptId", "mode", "ruleId", "type", "severity", "evidenceKey", "observed", "sourceRef", "detector", "etalonVersion", "createdAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "attemptId": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/mode" },
        "ruleId": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["critical", "major", "minor"] },
        "evidenceKey": { "type": "string", "minLength": 1 },
        "fieldPath": { "type": "string" },
        "eventId": { "type": "string" },
        "observed": { "type": "string" },
        "expected": { "type": "string" },
        "sourceRef": { "type": "string", "minLength": 1 },
        "detector": { "type": "string", "enum": ["rule", "ml", "llm_confirmed", "teacher"] },
        "etalonVersion": { "type": "string", "minLength": 1 },
        "assessorVersion": { "type": "string" },
        "fixed": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "teacherId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "evaluationExtension": {
      "type": "object",
      "required": ["schemaVersion", "attemptId", "mode", "status", "revision", "availableAxes", "etalonVersion", "assessorVersion", "errors"],
      "properties": {
        "schemaVersion": { "const": "ai-workflow/1" },
        "attemptId": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/mode" },
        "status": { "type": "string", "enum": ["pending", "preliminary", "review_required", "final"] },
        "revision": { "type": "integer", "minimum": 1 },
        "availableAxes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["timeScore", "correctnessScore", "grammarScore", "semanticScore"] } },
        "totalScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "etalonVersion": { "type": "string", "minLength": 1 },
        "assessorVersion": { "type": "string", "minLength": 1 },
        "modelReleaseId": { "type": ["string", "null"] },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/errorRecord" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "enum": ["pending", "review_required"] } }, "required": ["status"] },
          "then": { "not": { "required": ["totalScore"] } }
        },
        {
          "if": { "properties": { "status": { "enum": ["preliminary", "final"] } }, "required": ["status"] },
          "then": { "required": ["totalScore"] }
        }
      ],
      "additionalProperties": true
    },
    "reportExtension": {
      "type": "object",
      "required": ["schemaVersion", "sessionId", "generatedAt", "attemptIds", "errorCounts", "reviewPendingCount"],
      "properties": {
        "schemaVersion": { "const": "ai-workflow/1" },
        "sessionId": { "type": "string", "minLength": 1 },
        "generatedAt": { "type": "string", "format": "date-time" },
        "attemptIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "errorCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "reviewPendingCount": { "type": "integer", "minimum": 0 },
        "errorRecordIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "semanticDecision": {
      "type": "object",
      "required": ["decision", "explanation", "referenceFactIds"],
      "properties": {
        "decision": { "type": "string", "enum": ["equivalent", "different", "uncertain"] },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 500 },
        "referenceFactIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "maxItems": 12 },
        "missingFactIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "maxItems": 12 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  }
}
