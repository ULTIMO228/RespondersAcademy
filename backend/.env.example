# Строка подключения SQLAlchemy (async). По умолчанию — SQLite в backend/var/dev.db.
DATABASE_URL=sqlite+aiosqlite:///./var/dev.db
# PostgreSQL (боевой контур):
# DATABASE_URL=postgresql+asyncpg://arm112:arm112@localhost:5432/arm112

# Секрет подписи JWT (обязателен во всех режимах, минимум 32 байта; сгенерируйте свой).
JWT_SECRET=
JWT_TTL_HOURS=24

# Корень репозитория с сидами (spec/000-фронт/mocks, mocks/local, mocks/admin). По умолчанию — родительская папка backend/.
# SEED_DIR=..

# Каталог локальных моделей (эмбеддер, спеллчекер, TTS). Заполняется ml/scripts/prepare_models.py.
MODELS_DIR=./models

# Ollama (опционально): при недоступности генерация сценариев идёт по шаблонному пути.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_TIMEOUT_SEC=120

# Прогрев ML-компонент при старте (эмбеддер, spellcheck, классификатор) в фоне; 0 — отключить.
# ML_WARMUP=1

# Синтез аудиозаписи обращения (Silero v4 ru, `prepare_models --only tts`); 0 — только расшифровка («аварийный режим»).
# TTS_ENABLED=1

# Дообученная Qwen3.5-0.8B (docs/model-report/QUICKSTART.md): python backend/ml/scripts/run_semantic_model.py
# LLAMA_URL=http://127.0.0.1:8081
# LLAMA_MODEL=semantic-review

# Живой заявитель в тренировке: Vosk → разговорная LLM → Silero (docs/LIVE-CALLER.md).
# LIVE_CALLS_ENABLED=true
# LIVE_CALL_LLM_URL=http://127.0.0.1:8082
# LIVE_CALL_LLM_MODEL=caller
# LIVE_CALL_LLM_OLLAMA=false
# LIVE_CALL_MAX_SEC=180

# Альтернатива для финала: сильная модель с доступными весами через облачный API.
# Ключ — только здесь/в серверном окружении, никогда в NEXT_PUBLIC_*.
# LIVE_CALL_LLM_TRANSPORT=api
# LIVE_CALL_LLM_URL=https://openrouter.ai/api/v1
# LIVE_CALL_LLM_MODEL=qwen/qwen3-235b-a22b-2507
# LIVE_CALL_LLM_API_KEY=

# Живой SpeechKit STT/TTS v3 + та же разговорная LLM (docs/LIVE-CALLER-SPEECHKIT.md).
# uv sync --extra speechkit --extra tts
# LIVE_CALL_REALTIME_TRANSPORT=speechkit
# SPEECHKIT_API_KEY=
# SPEECHKIT_FOLDER_ID=
# SPEECHKIT_TTS_MODEL=livetts
# SPEECHKIT_VOICE=denis
# SPEECHKIT_ROLE=casual
# Для general явно выберите совместимые голос/амплуа: alexander / neutral.
# LIVE_CALL_REPLY_MODE=auto
# auto: api → естественные реплики, local → выбор фактов. Можно явно facts/dialogue.
# Потоковая речь Qwen3-Omni за SGLang-Omni (отдельный GPU-сервер).
# LIVE_CALL_REALTIME_TRANSPORT=omni
# LIVE_CALL_REALTIME_URL=ws://127.0.0.1:8008/v1/realtime
# LIVE_CALL_REALTIME_KEY=  # только если шлюз требует Bearer; не нужен для SSH-туннеля
# WS нашего backend, доступный браузеру. В продакшене wss за reverse proxy.
# LIVE_CALL_PUBLIC_WS_URL=ws://127.0.0.1:8000/api/v1/operator112/realtime

# Бесплатный тест: локальные Vosk/Silero + потоковый ответ Groq, без GPU.
# LIVE_CALL_REALTIME_TRANSPORT=cascade
# LIVE_CALL_LLM_URL=https://api.groq.com/openai/v1
# LIVE_CALL_LLM_MODEL=qwen/qwen3.8-27b
# LIVE_CALL_LLM_API_KEY=
