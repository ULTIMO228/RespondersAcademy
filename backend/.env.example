# Строка подключения SQLAlchemy (async). По умолчанию — SQLite в backend/var/dev.db.
DATABASE_URL=sqlite+aiosqlite:///./var/dev.db
# PostgreSQL (боевой контур):
# DATABASE_URL=postgresql+asyncpg://arm112:arm112@localhost:5432/arm112

# Секрет подписи JWT (обязателен во всех режимах, минимум 32 байта; сгенерируйте свой).
JWT_SECRET=
JWT_TTL_HOURS=24

# Корень репозитория с сидами (spec/000-фронт/mocks, mocks/local, mocks/admin). По умолчанию — родительская папка backend/.
# SEED_DIR=..

# Каталог локальных моделей (эмбеддер, спеллчекер, TTS). Заполняется ml/scripts/prepare_models.py.
MODELS_DIR=./models

# Ollama (опционально): при недоступности генерация сценариев идёт по шаблонному пути.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_TIMEOUT_SEC=120

# Прогрев ML-компонент при старте (эмбеддер, spellcheck, классификатор) в фоне; 0 — отключить.
# ML_WARMUP=1

# Синтез аудиозаписи обращения (Silero v4 ru, `prepare_models --only tts`); 0 — только расшифровка («аварийный режим»).
# TTS_ENABLED=1

# Дообученная Qwen3.5-0.8B (docs/model-report/QUICKSTART.md): python backend/ml/scripts/run_semantic_model.py
# LLAMA_URL=http://127.0.0.1:8081
# LLAMA_MODEL=semantic-review

# Внешний провайдер моделей Polza.ai (по умолчанию выключен): local | polza.
# Условие организаторов (19.10.2026): только модели с открытыми весами, которые заказчик сможет
# развернуть у себя на сервере из ТЗ; адрес и модели — только в настройках (без хардкода).
# Точные ID моделей сверяйте по каталогу: GET $POLZA_BASE_URL/models (фильтр type=chat|tts|...).
# AI_PROVIDER=polza
# POLZA_API_KEY=
# POLZA_BASE_URL=https://polza.ai/api/v1
# POLZA_MODEL=<ID Qwen3.6-35B-A3B или другой открытой модели из каталога>
# POLZA_TIMEOUT_SEC=60
# POLZA_RPM=20
# POLZA_DAILY_LIMIT=500

# Живой ИИ-заявитель через Polza.ai (основной путь, docs/LIVE-CALLER-POLZA.md):
# локальный Silero VAD → STT → потоковый LLM → TTS с эмоцией. Ключ и адрес — POLZA_* выше.
# Нужны: uv sync --extra tts (torch) и uv run python -m ml.scripts.prepare_models --only vad
# LIVE_CALLS_ENABLED=true
# LIVE_CALL_REALTIME_TRANSPORT=polza
# LIVE_CALL_POLZA_CHAT_MODEL=qwen/qwen3-30b-a3b-instruct-2507  # решение команды: Qwen, ~20 ГБ в 4-бит — сервер из ТЗ
#   без размышления: LIVE_CALL_POLZA_REASONING_* не задавать
# Не под ТЗ (~328 ГБ): z-ai/glm-5.3-flash + LIVE_CALL_POLZA_REASONING_MAX_TOKENS=64 (размышление обязательное)
# Быстрее (первое слово ~0,9 с), но ошибается в фактах (замер 20.10): qwen/qwen3.8-27b
#   + LIVE_CALL_POLZA_REASONING_OFF=true  LIVE_CALL_POLZA_PROVIDER=cerebras/fp16
# LIVE_CALL_POLZA_STT_MODEL=ai-sage/gigaam-v3
# LIVE_CALL_TTS_ENGINE=silero                         # голос локально (CPU, без сети): uv run python -m ml.scripts.prepare_models --only tts-live
# LIVE_CALL_SILERO_MODEL=v5_6_ru.pt
# LIVE_CALL_SILERO_SPEAKER=xenia                       # aidar | baya | kseniya | eugene | xenia
# LIVE_CALL_POLZA_TTS_MODEL=openai/gpt-4o-mini-tts     # ⚠️ в Polza нет открытых TTS (19.10)
# LIVE_CALL_POLZA_TTS_VOICE=coral                      # Polza требует voice
# LIVE_CALL_POLZA_TTS_FORMAT=wav            # wav | pcm (pcm = 24 кГц, 16 бит, моно)
# LIVE_CALL_POLZA_TTS_INSTRUCTIONS=true     # передавать эмоцию инструкцией (instructions)
# LIVE_CALL_END_SILENCE_MS=700              # пауза, после которой реплика оператора отправляется
# LIVE_CALL_BARGE_IN_SEC=4                 # встревоженный заявитель перебивает речь оператора длиннее N с (0 — нет)
# LIVE_CALL_BARGE_PREPARE_SEC=1.5          # реплику-перебивание готовить заранее, после N с речи оператора
# LIVE_CALL_EARLY_COMMIT_MS=250            # распознавание стартует уже после этой паузы (0 — ждать всю паузу)
# LIVE_CALL_SOUNDS_DIR=                     # библиотека вздохов/всхлипов: sigh/ sob/ cough/ breath/ *.wav
# LIVE_CALL_MAX_SEC=180
# WS нашего backend, доступный браузеру. В продакшене wss за reverse proxy.
# LIVE_CALL_PUBLIC_WS_URL=ws://127.0.0.1:8000/api/v1/operator112/realtime

# Прототипы живого заявителя (история выбора, docs/LIVE-CALLER.md). Не для показа экспертам:
# speechkit — закрытые модели Яндекса; omni — нужен GPU, которого нет в ТЗ.
# cascade: локальные Vosk/Silero + LLM по OpenAI-совместимому API.
# LIVE_CALL_REALTIME_TRANSPORT=cascade
# LIVE_CALL_LLM_URL=
# LIVE_CALL_LLM_MODEL=
# LIVE_CALL_LLM_API_KEY=
# WAV-прототип: LIVE_CALL_LLM_TRANSPORT=local|api, LIVE_CALL_LLM_OLLAMA, LIVE_CALL_REPLY_MODE=auto|facts|dialogue
# speechkit: uv sync --extra speechkit; SPEECHKIT_API_KEY, SPEECHKIT_FOLDER_ID, SPEECHKIT_TTS_MODEL, SPEECHKIT_VOICE, SPEECHKIT_ROLE
# omni: LIVE_CALL_REALTIME_URL=ws://127.0.0.1:8008/v1/realtime, LIVE_CALL_REALTIME_KEY
